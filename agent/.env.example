# Copy to .env and fill in real values. NEVER commit .env.
# All values below are placeholders.

# --- ASR: Deepgram ---
DEEPGRAM_API_KEY=your-deepgram-api-key-here

# --- LLM: Groq (Llama) ---
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# --- TTS: Cartesia (primary) ---
CARTESIA_API_KEY=your-cartesia-api-key-here
CARTESIA_VOICE_ID=your-cartesia-voice-id-here
# TODO(Phase 1/4): Piper (free-tier local TTS) needs no API key; add a TTS_PROVIDER switch.

# --- Telephony: Twilio (Phase 7) ---
TWILIO_ACCOUNT_SID=your-twilio-account-sid-here
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
TWILIO_PHONE_NUMBER=+15555550100

# --- Scheduling API (local mock backend) ---
SCHEDULING_API_BASE_URL=http://127.0.0.1:8000
